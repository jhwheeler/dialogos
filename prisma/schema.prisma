generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  free
  paid
}

enum SessionStatus {
  draft
  active
  ended
  aborted
}

enum TriviumStage {
  grammar
  logic
  rhetoric
  combined
}

enum SourceType {
  photo_ocr
  document
  reference
  voice_summary
}

enum Strictness {
  low
  medium
  high
}

model Student {
  id                    String       @id @default(uuid()) @db.Uuid
  email                 String?
  displayName           String       @map("display_name")
  plan                  Plan         @default(free)
  trialRemainingSeconds Int          @default(180) @map("trial_remaining_seconds")
  voiceRate             Float?       @map("voice_rate")
  autoplay              Boolean?
  strictness            Strictness?
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(6)

  topics   Topic[]
  sessions Session[]

  @@map("students")
}

model Topic {
  id          String    @id @default(uuid()) @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  title       String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  student  Student   @relation(fields: [studentId], references: [id])
  files    TopicFile[]
  sources  Source[]
  sessions Session[]

  @@map("topics")
}

model TopicFile {
  id           String    @id @default(uuid()) @db.Uuid
  topicId       String    @map("topic_id") @db.Uuid
  kind          String
  storageKey    String    @map("storage_key")
  originalName  String    @map("original_name")
  mimeType      String?   @map("mime_type")
  sizeBytes     BigInt    @map("size_bytes")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  topic   Topic    @relation(fields: [topicId], references: [id])
  sources Source[]

  @@map("topic_files")
}

model Source {
  id            String     @id @default(uuid()) @db.Uuid
  topicId       String     @map("topic_id") @db.Uuid
  topicFileId   String?    @map("topic_file_id") @db.Uuid
  sourceType    SourceType @map("source_type")
  title         String
  citation      String?
  extractedText String?    @map("extracted_text")
  groundingTier Int        @default(3) @map("grounding_tier")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(6)

  topic     Topic      @relation(fields: [topicId], references: [id])
  topicFile TopicFile? @relation(fields: [topicFileId], references: [id])
  sessions  Session[]

  @@map("sources")
}

model Session {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @map("student_id") @db.Uuid
  topicId           String        @map("topic_id") @db.Uuid
  sourceId          String?       @map("source_id") @db.Uuid
  triviumStage      TriviumStage  @default(combined) @map("trivium_stage")
  status            SessionStatus
  startedAt         DateTime?     @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?     @map("ended_at") @db.Timestamptz(6)
  costCentsEstimate Int           @default(0) @map("cost_cents_estimate")
  trialSecondsUsed  Int           @default(0) @map("trial_seconds_used")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  student   Student           @relation(fields: [studentId], references: [id])
  topic     Topic             @relation(fields: [topicId], references: [id])
  source    Source?           @relation(fields: [sourceId], references: [id])
  turns     Turn[]
  artifacts SessionArtifact[]

  @@map("sessions")
}

model Turn {
  id                    String   @id @default(uuid()) @db.Uuid
  sessionId              String   @map("session_id") @db.Uuid
  index                 Int
  studentAudioKey       String?  @map("student_audio_key")
  studentText           String?  @map("student_text")
  assistantText         String?  @map("assistant_text")
  assistantPromptType   String?  @map("assistant_prompt_type")
  assistantDetectedIssue String? @map("assistant_detected_issue")
  latencyMs             Int?     @map("latency_ms")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, index])
  @@map("turns")
}

model SessionArtifact {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  kind      String
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id])

  @@map("session_artifacts")
}
